# Copiar a .env y ajustar. NO commitear .env.

# --- Django ---
# Generar con:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# (url-safe a propósito: evita $ y comillas que rompen el parser de .env de docker compose)
DJANGO_SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/Mexico_City
DJANGO_LANGUAGE_CODE=es
DJANGO_LOG_LEVEL=INFO

# --- Base de datos (PostgreSQL) ---
DATABASE_URL=postgres://budget:budget@localhost:5432/budget

# --- JWT ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# --- CORS (front web). Vacío = mismo origen; en DEBUG sin valor se permite todo. ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
# Resultados descartados por defecto (CELERY_TASK_IGNORE_RESULT=True).
# Definir solo si se necesita inspeccionar resultados de tareas.
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Cache (backend del throttling de DRF). Vacío = en memoria. En prod: Redis. ---
# CACHE_URL=redis://localhost:6379/2

# --- Rate limits (opcional; valores por defecto entre paréntesis) ---
# THROTTLE_ANON=40/min
# THROTTLE_USER=1000/hour
# THROTTLE_AUTH=10/min
# THROTTLE_INBOUND=120/min
# THROTTLE_QUICK_ADD=60/min

# --- Importación por correo bancario (webhook) ---
INBOUND_EMAIL_LOCALPART=import
INBOUND_EMAIL_DOMAIN=inbound.tudominio.com
# Secreto que el proveedor de correo debe mandar en X-Inbound-Secret.
# Vacío = el endpoint rechaza todo. Generar: python -c "import secrets; print(secrets.token_urlsafe(32))"
INBOUND_WEBHOOK_SECRET=
# Alternativa: verificación de firma HMAC nativa de Mailgun (si se define,
# se usa cuando el payload trae timestamp/token/signature).
# INBOUND_MAILGUN_SIGNING_KEY=

# --- Correo saliente (invitaciones de workspace) vía Mailgun ---
# Relay SMTP de Mailgun: smtp.mailgun.org, puerto 587, usuario/clave de un
# "Sending domain" verificado. Sin esto, en DEBUG los correos solo se
# imprimen en la consola (no se envían de verdad).
# EMAIL_HOST_USER=postmaster@mg.tu-dominio.com
# EMAIL_HOST_PASSWORD=
# INVITE_ACCEPT_URL_BASE=budget://invite

# --- "Continuar con Google" ---
# Client ID(s) de OAuth (Google Cloud Console), separados por coma -- uno por
# plataforma (iOS/Android/Web) que use la app. Vacío = solo para dev.
# GOOGLE_CLIENT_IDS=xxxx.apps.googleusercontent.com

# --- Adjuntos (recibos de transacciones) ---
# Vacío = se guardan en disco local (media/), ok para dev. En producción
# (Cloud Run u otro contenedor efímero) hay que setearla o los recibos se
# pierden en el próximo deploy. El bucket queda privado: la app nunca
# expone su URL, sirve el archivo a través del propio API.
# GS_BUCKET_NAME=budget-recibos-prod

# --- Producción (solo si DJANGO_DEBUG=False) ---
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.tu-dominio.com
# DJANGO_DEFAULT_FROM_EMAIL=no-reply@tu-dominio.com

# ---------------------------------------------------------------------------
# Deploy: Cloud Run + Neon (sin Celery). Ver DEPLOY.md.
# Estas variables se fijan en el servicio de Cloud Run, NO en un archivo .env.
# ---------------------------------------------------------------------------
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=<python -c "import secrets; print(secrets.token_urlsafe(64))">
# DJANGO_ALLOWED_HOSTS=.run.app                      # + tu dominio propio si lo hay
# DJANGO_CSRF_TRUSTED_ORIGINS=https://*.run.app
# CORS_ALLOWED_ORIGINS=https://budget-web.vercel.app  # el dominio de Vercel
# DATABASE_URL=postgres://USER:PASS@ep-xxx.REGION.aws.neon.tech/budget?sslmode=require
# DJANGO_DB_CONN_MAX_AGE=0                            # Cloud Run congela la instancia
# DJANGO_DB_DISABLE_SERVER_SIDE_CURSORS=True         # solo si usás el endpoint pooled de Neon
# DJANGO_TIME_ZONE=America/Mexico_City
# RUN_MIGRATIONS=1                                   # migra al arrancar el contenedor
